# Scoped sudo for the cooldown web app — install as /etc/sudoers.d/cooldown:
#
#   sudo install -m 440 -o root -g root deploy/sudoers.d-cooldown /etc/sudoers.d/cooldown
#   sudo visudo -c            # ALWAYS validate before logging out
#
# The app reads one iptables counter chain (TRAFFIC_ACCT) to tell encrypted traffic from
# plaintext for the packet-feed background. That is the ONLY privileged thing it does, and
# this rule is the only privileged thing it should be able to do. The command is fully
# qualified with its arguments, so this grants a single read — not "run iptables".
#
# The app runs as a dedicated `cooldownapp` system account (no password, no login shell,
# not in the sudo group), so this rule is the ONLY thing it can do with elevated rights.
# Create it and let it reach the code with:
#
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin cooldownapp
#   sudo chmod 711 /home/<you>        # traverse-only; contents stay unlistable
#
# and set `User=cooldownapp` in cooldown-app.service. If you instead run the app as a
# user with blanket NOPASSWD:ALL, any flaw in the app is root — this rule documents the
# requirement but cannot take that privilege away.

Cmnd_Alias COOLDOWN_ACCT = /usr/sbin/iptables -t mangle -nvxL TRAFFIC_ACCT

cooldownapp ALL=(root) NOPASSWD: COOLDOWN_ACCT
